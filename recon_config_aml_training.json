{
  "raw": {
    "glob": "Training_Progress_Report_*.xlsx",
    "sheet_name": "Training Progress Report",
    "header_mode": "grouped",
    "group_header_row": 1,
    "field_header_row": 2,
    "data_start_row": 3
  },
  "recon": {
    "path": "AML_Training_Full_Reconciliation_Reaudited_Final.xlsx",
    "records_sheet": "All Records",
    "header_row": 3,
    "data_start_row": 4,
    "source_file_column": "Source File",
    "source_file_transform": {
      "pattern": "Training_Progress_Report_",
      "repl": "Training Progress Report_"
    }
  },
  "join": {
    "mode": "positional"
  },
  "raw_date_format": "%d.%m.%Y",
  "field_map": {
    "User Info::ID": "User ID",
    "User Info::Full Name": "Full Name",
    "User Info::Username": "Username",
    "User Info::Roles": "Roles",
    "User Info::Staff category": "Staff Category",
    "User Info::Department": "Department",
    "User Info::Region": "Region",
    "User Info::Territory": "Territory",
    "User Info::Shop Name/Team": "Shop/Team",
    "Learning Item Info::ID": "Learning Item ID",
    "Learning Item Info::Title": "Learning Title",
    "Learning Item Info::Category/Subcategory/Training": "Training Category",
    "Assignment Info::Type": "Assignment Type",
    "Assignment Info::ID": "Assignment ID",
    "Assignment Info::Assignement title": "Assignment Title",
    "Assignment Info::Assignement Status": "Assignment Status",
    "User Progress::Completed Status": "Completion Status",
    "User Progress::Result Status": "Result Status",
    "User Progress::Training Hours": "Training Hours"
  },
  "date_field_map": {
    "Assignment Info::Begin Date": "Assignment Begin",
    "Assignment Info::End Date": "Assignment End",
    "User Progress::Begin Date": "Progress Begin",
    "User Progress::End Date": "Progress End"
  },
  "derived_checks": [
    {
      "name": "Population classification",
      "type": "role_evidence",
      "source_col": "Roles",
      "target_col": "Population",
      "generic_marker": "MZI - Registration profile classification",
      "true_value": "Internal staff",
      "false_value": "External partner"
    },
    {
      "name": "Completed Flag",
      "type": "value_in_set",
      "source_col": "Completion Status",
      "target_col": "Completed Flag",
      "match_values": ["Completed Outof deadline", "Completed Within deadline"]
    },
    {
      "name": "Passed Flag",
      "type": "value_equals",
      "source_col": "Result Status",
      "target_col": "Passed Flag",
      "match_value": "Passed"
    },
    {
      "name": "Started Not Completed Flag",
      "type": "value_equals",
      "source_col": "Completion Status",
      "target_col": "Started Not Completed Flag",
      "match_value": "Started but Not Completed"
    },
    {
      "name": "Not Started Flag",
      "type": "value_equals",
      "source_col": "Completion Status",
      "target_col": "Not Started Flag",
      "match_value": "Not Started"
    },
    {
      "name": "Assignment Year",
      "type": "year_of_date",
      "source_col": "Assignment Begin",
      "target_col": "Assignment Year"
    }
  ],
  "summary_checks": [
    {
      "name": "Course Reconciliation - assignment cohorts",
      "sheet_name": "Course Reconciliation",
      "header_row": 11,
      "data_start_row": 12,
      "group_by": ["Assignment ID"],
      "metrics": {
        "Rows": {"col": "User ID", "agg": "count"},
        "Unique Participants": {"col": "User ID", "agg": "nunique"},
        "Completed": {"col": "Completed Flag", "agg": "sum"},
        "Passed": {"col": "Passed Flag", "agg": "sum"},
        "Started Not Completed": {"col": "Started Not Completed Flag", "agg": "sum"},
        "Not Started": {"col": "Not Started Flag", "agg": "sum"},
        "Completed Late": {"col": "Completed Late Flag", "agg": "sum"}
      }
    },
    {
      "name": "Year Movement",
      "sheet_name": "Year Movement",
      "header_row": 5,
      "data_start_row": 6,
      "data_end_row": 9,
      "group_by": ["Assignment Year", "Snapshot Lifecycle", "Population"],
      "key_map": {"Assignment Year": "Assignment Year", "Snapshot Lifecycle": "Lifecycle", "Population": "Population"},
      "metrics": {
        "Assignment Rows": {"col": "User ID", "agg": "count"},
        "Unique Participants": {"col": "User ID", "agg": "nunique"},
        "Completed": {"col": "Completed Flag", "agg": "sum"},
        "Passed": {"col": "Passed Flag", "agg": "sum"},
        "Started Not Completed": {"col": "Started Not Completed Flag", "agg": "sum"},
        "Not Started": {"col": "Not Started Flag", "agg": "sum"},
        "Completed Late": {"col": "Completed Late Flag", "agg": "sum"}
      }
    }
  ],
  "cell_checks": [
    {
      "name": "Assignment Rows (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "A5",
      "metric": {"col": "User ID", "agg": "count"}
    },
    {
      "name": "Unique Participants (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "C5",
      "metric": {"col": "User ID", "agg": "nunique"}
    },
    {
      "name": "Completed All (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "I5",
      "metric": {"col": "Completed Flag", "agg": "sum"}
    },
    {
      "name": "Closed rows (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "A9",
      "filter": "`Snapshot Lifecycle` == 'Closed at snapshot'",
      "metric": {"col": "User ID", "agg": "count"}
    },
    {
      "name": "Active rows (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "E9",
      "filter": "`Snapshot Lifecycle` == 'Active at snapshot'",
      "metric": {"col": "User ID", "agg": "count"}
    },
    {
      "name": "Completed Late (Executive Summary)",
      "sheet": "Executive Summary",
      "cell": "I9",
      "metric": {"col": "Completed Late Flag", "agg": "sum"}
    }
  ]
}
